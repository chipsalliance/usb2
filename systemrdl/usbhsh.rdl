        } ATL_LAST[4:0] = 5'h0;
        field {
            sw = rw; hw = r;
            desc = "This indicates the last PTD in the ISO list.";
        } ISO_LAST[12:8] = 5'h0;
        field {
            sw = rw; hw = r;
            desc = "This indicates the last PTD in the INT list.";
