            sw = r; hw = w;
            desc = "This bit indicates whether the ports support port indicator control.";
        } P_INDICATOR[16:16] = 1'h1;
    };
    hcsparams_t HCSPARAMS @ 0x4;

    // Host Controller Capability Parameters
    reg hccparams_t {
        field {
            sw = r; hw = w;
            desc = "Link Power Management Capability.";
        } LPMC[17:17] = 1'h1;
    };
    hccparams_t HCCPARAMS @ 0x8;

    // Frame Length Adjustment
    reg fladj_frindex_t {
        field {
            sw = rw; hw = r;
