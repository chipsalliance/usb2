            desc = "Software writes this bit to one to start a read or write operation.";
        } PHY_ACCESS[25:25] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "This bit indicates if the interface between the controller is UTMI+ or ULPI 0b: UTMI+ 1b: ULPI If the hardware supports both modes, this bit is RW by SW.";
        } PHY_MODE[31:31] = 1'h0;
