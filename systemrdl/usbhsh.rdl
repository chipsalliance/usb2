            desc = "Frame Index: Bits 29 to16 in this register are used for the frame number field in the SOF packet.";
        } FRINDEX[29:16] = 14'h0;
    };
    fladj_frindex_t FLADJ_FRINDEX @ 0xC;

    // Memory base address where ATL PTD0 is stored
    reg atl_ptd_base_addr_t {
        field {
            sw = rw; hw = r;
            desc = "This indicates the current PTD that is used by the hardware when it is processing the ATL list.";
        } ATL_CUR[8:4] = 5'h0;
        field {
            sw = rw; hw = r;
            desc = "Base address to be used by the hardware to find the start of the ATL list.";
        } ATL_BASE[31:9] = 23'h0;
    };
    atl_ptd_base_addr_t ATL_PTD_BASE_ADDR @ 0x10;

    // Memory base address where ISO PTD0 is stored
    reg iso_ptd_base_addr_t {
        field {
            sw = rw; hw = r;
            desc = "This indicates the first PTD that is used by the hardware when it is processing the ISO list.";
        } ISO_FIRST[9:5] = 5'h0;
        field {
            sw = rw; hw = r;
            desc = "Base address to be used by the hardware to find the start of the ISO list.";
        } ISO_BASE[31:10] = 22'h0;
    };
    iso_ptd_base_addr_t ISO_PTD_BASE_ADDR @ 0x14;

    // Memory base address where INT PTD0 is stored
    reg int_ptd_base_addr_t {
        field {
            sw = rw; hw = r;
            desc = "This indicates the first PTD that is used by the hardware when it is processing the INT list.";
        } INT_FIRST[9:5] = 5'h0;
        field {
            sw = rw; hw = r;
            desc = "Base address to be used by the hardware to find the start of the INT list.";
        } INT_BASE[31:10] = 22'h0;
    };
    int_ptd_base_addr_t INT_PTD_BASE_ADDR @ 0x18;

    // Memory base address that indicates the start of the data payload buffers
    reg data_payload_base_addr_t {
        field {
            sw = rw; hw = r;
