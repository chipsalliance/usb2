    // This register contains the offset value towards the start of the operational register space and the version number of the IP block
    reg caplength_chipid_t {
        field {
            sw = r; hw = w;
            desc = "Capability Length: This is used as an offset.";
        } CAPLENGTH[7:0] = 8'h10;
        field {
            sw = r; hw = w;
            desc = "Chip identification: indicates major and minor revision of the IP: [31:24] = Major revision [23:16] = Minor revision Major revisions used: 0x01: USB2.";
        } CHIPID[31:16] = 16'h101;
    };
    caplength_chipid_t CAPLENGTH_CHIPID @ 0x0;

    // Host Controller Structural Parameters
    reg hcsparams_t {
        field {
