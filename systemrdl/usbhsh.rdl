        } FLRE[3:3] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "ATL IRQ Enable bit: 1: enable 0: disable.";
        } ATL_IRQ_E[16:16] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "ISO IRQ Enable bit: 1: enable 0: disable.";
        } ISO_IRQ_E[17:17] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "INT IRQ Enable bit: 1: enable 0: disable.";
        } INT_IRQ_E[18:18] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "SOF Interrupt Enable bit: 1: enable 0: disable.";
        } SOF_E[19:19] = 1'h0;
    };
    usbintr_t USBINTR @ 0x28;

    // Port Status and Control register
    reg portsc1_t {
        field {
            sw = rw; hw = r;
            desc = "Current Connect Status: Logic 1 indicates a device is present on the port.";
        } CCS[0:0] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Connect Status Change: Logic 1 means that the value of CCS has changed.";
        } CSC[1:1] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Port Enabled/Disabled.";
        } PED[2:2] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Port Enabled/Disabled Change: Logic 1 means that the value of PED has changed.";
        } PEDC[3:3] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Over-current active: Logic 1 means that this port has an over-current condition.";
        } OCA[4:4] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Over-current change: Logic 1 means that the value of OCA has changed.";
        } OCC[5:5] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Force Port Resume: Logic 1 means resume (K-state) detected or driven on the port.";
        } FPR[6:6] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Suspend: Logic 1 means port is in the suspend state.Logic 0 means the port is not suspended.";
        } SUSP[7:7] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Port Reset: Logic 1 means the port is in the reset state.";
        } PR[8:8] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Suspend using L1 0b = Suspend using L2 1b = Suspend using L1 When this bit is set to a 1 and a non-zero value is specified in the Device Address field, the host controller will generate an LPM Token to enter the L1 state whenever software writes a one to the Suspend bit, as well as L1 exit timing during any device or host-initiated resume.";
        } SUS_L1[9:9] = 1'h0;
        field {
            sw = r; hw = w;
            desc = "Line Status: This field reflects the current logical levels of the DP (bit 11) and DM (bit 10) signal lines.";
        } LS[11:10] = 2'h0;
        field {
            sw = rw; hw = r;
            desc = "Port Power: The function of this bit depends on the value of the Port Power Control (PPC) bit in the HCSPARAMS register.";
        } PP[12:12] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "ReservedPort Force Full Speed Connect. Writing this bit to a 1b will force the port to only connect at full-speed. It disables the chirp sequences that allows the port to identify itself as high-speed";
        } PFSC[13:13] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Port Indicator Control : Writing to this field has no effect if the P_INDICATOR bit in the HCSPARAMS register is logic 0.";
        } PIC[15:14] = 2'h0;
        field {
            sw = rw; hw = r;
            desc = "Port Test Control: A non-zero value indicates that the port is operating in the test mode as indicated by the value.";
        } PTC[19:16] = 4'h0;
        field {
            sw = rw; hw = r;
            desc = "Port Speed: 00b: Low-speed 01b: Full-speed 10b: High-speed 11b: Reserved.";
        } PSPD[21:20] = 2'h0;
        field {
            sw = rw; hw = r;
            desc = "Wake on overcurrent enable: Writing this bit to a one enables the port to be sensitive to overcurrent conditions as wake-up events.";
        } WOO[22:22] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "These two bits are used by software to determine whether the most recent L1 suspend request was successful: 00b: Success-state transition was successful (ACK) 01b: Not Yet - Device was unable to enter the L1 state at this time (NYET) 10b: Not supported - Device does not support the L1 state (STALL) 11b: Timeout/Error - Device failed to respond or an error occurred.";
        } SUS_STAT[24:23] = 2'h0;
        field {
            sw = rw; hw = r;
            desc = "Device Address for LPM tokens.";
        } DEV_ADD[31:25] = 7'h0;
    };
