            sw = rw; hw = r;
            desc = "bRemoteWake field.";
        } LPM_RWU[28:28] = 1'h0;
    };
    usbcmd_t USBCMD @ 0x20;

    // USB Interrupt Status register
    reg usbsts_t {
        field {
            sw = rw; hw = r;
            desc = "Port Change Detect: The host controller sets this bit to logic 1 when any port has a change bit transition from a 0 to a one or a Force Port Resume bit transition from a 0 to a 1 as a result of a J-K transition detected on a suspended port. or               - the ID pin value changes or               - an LPM token has been transmitted to enter LPM L1 suspend state..               Software must write a one to clear the bit";
        } PCD[2:2] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Frame List Rollover: The host controller sets this bit to logic 1 when the frame list index rolls over its maximum value to 0.";
        } FLR[3:3] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "ATL IRQ: Indicates that an ATL PTD (with I-bit set) was completed.";
        } ATL_IRQ[16:16] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "ISO IRQ: Indicates that an ISO PTD (with I-bit set) was completed.";
        } ISO_IRQ[17:17] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "INT IRQ: Indicates that an INT PTD (with I-bit set) was completed.";
        } INT_IRQ[18:18] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "SOF interrupt: Every time when the host sends a Start of Frame token on the USB bus, this bit is set.";
        } SOF_IRQ[19:19] = 1'h0;
    };
    usbsts_t USBSTS @ 0x24;

    // USB Interrupt Enable register
    reg usbintr_t {
        field {
            sw = rw; hw = r;
            desc = "Port Change Detect Interrupt Enable: 1: enable 0: disable.";
        } PCDE[2:2] = 1'h0;
        field {
            sw = rw; hw = r;
