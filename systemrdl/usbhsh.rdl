            desc = "Run/Stop: 1b = Run.";
        } RS[0:0] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Host Controller Reset: This control bit is used by the software to reset the host controller.";
        } HCRESET[1:1] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "Frame List Size: This field specifies the size of the frame list.";
        } FLS[3:2] = 2'h0;
        field {
            sw = rw; hw = r;
            desc = "Light Host Controller Reset: This bit allows the driver software to reset the host controller without affecting the state of the ports.";
        } LHCR[7:7] = 1'h0;
        field {
            sw = rw; hw = r;
            desc = "ATL List enabled.";
        } ATL_EN[8:8] = 1'h0;
        field {
