//
// USB OCP Recovery v1.1 register map
//
// This file is the single source of truth for the USB transport view of the
// OCP Secure Firmware Recovery v1.1 command window. It is modeled after the
// in-tree I3C reference RDL, but the top-level addrmap is flattened for direct
// placement at SOC_USB_OCP_RECOVERY_BASE_ADDR and the I3C-only EXTCAP_HEADER
// is intentionally omitted.

addrmap usb_ocp_recovery_reg {
    name = "USB OCP Recovery";
    desc = "USB transport OCP Secure Firmware Recovery v1.1 register aperture. OCP command fields follow OCP Recovery v1.1 Sec 9.2 command summaries, with USB-specific live-status behaviors aligned to usb_ocp_recovery_regs.sv and usb_ocp_recovery_cms_fifo.sv.";
    default regwidth = 32;
    default hw = na;

    // PROT_CAP command (cmd 0x22, bytes 0-15).
    reg {
        name = "Recovery Protocol Capabilities 0";
        desc = "PROT_CAP bytes 0-3. OCP Recovery v1.1 Sec 9.2 PROT_CAP command/Table 9-3.";
        field {
            name = "Recovery protocol magic string 0";
            desc = "ASCII bytes 0-3 of the OCP RECV magic string. OCP Recovery v1.1 Sec 9.2 PROT_CAP/Table 9-3.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h2050434F;
        } REC_MAGIC_STRING_0[31:0];
    } PROT_CAP_0 @ 0x000;

    reg {
        name = "Recovery Protocol Capabilities 1";
        desc = "PROT_CAP bytes 4-7. OCP Recovery v1.1 Sec 9.2 PROT_CAP command/Table 9-3.";
        field {
            name = "Recovery protocol magic string 1";
            desc = "ASCII bytes 4-7 of the OCP RECV magic string. OCP Recovery v1.1 Sec 9.2 PROT_CAP/Table 9-3.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h56434552;
        } REC_MAGIC_STRING_1[31:0];
    } PROT_CAP_1 @ 0x004;

    reg {
        name = "Recovery Protocol Capabilities 2";
        desc = "PROT_CAP bytes 8-11. OCP Recovery v1.1 Sec 9.2 PROT_CAP command/Table 9-3.";
        field {
            name = "Recovery protocol version";
            desc = "Bytes 8-9 encode major=1 and minor=1 for OCP Recovery v1.1. OCP Recovery v1.1 Sec 9.2 PROT_CAP/Table 9-3.";
            sw = r;
            hw = w;
            we = false;
            reset = 16'h0101;
        } REC_PROT_VERSION[15:0];
        field {
            name = "Recovery protocol capabilities";
            desc = "Bytes 10-11 advertise supported capabilities. This reset value matches the USB wrapper REC_PROT_CAP_DEFAULT bitmap in ip_xxx_3516_hs_mem_wrapper.sv and OCP Recovery v1.1 Sec 9.2 PROT_CAP/Table 9-3.";
            sw = r;
            hw = w;
            we = false;
            reset = 16'h16BB;
        } AGENT_CAPS[31:16];
    } PROT_CAP_2 @ 0x008;

    reg {
        name = "Recovery Protocol Capabilities 3";
        desc = "PROT_CAP bytes 12-15. OCP Recovery v1.1 Sec 9.2 PROT_CAP/Table 9-3.";
        field {
            name = "Total number of CMS regions";
            desc = "Byte 12 reports the number of component memory spaces. The USB wrapper currently advertises two CMS regions. OCP Recovery v1.1 Sec 9.2 PROT_CAP/Table 9-3.";
            sw = r;
            hw = w;
            we = false;
            reset = 8'h02;
        } NUM_OF_CMS_REGIONS[7:0];
        field {
            name = "Maximum response time";
            desc = "Byte 13 reports maximum response time in 2^x microseconds. OCP Recovery v1.1 Sec 9.2 PROT_CAP/Table 9-3.";
            sw = r;
            hw = w;
            we = false;
            reset = 8'h00;
        } MAX_RESP_TIME[15:8];
        field {
            name = "Heartbeat period";
            desc = "Byte 14 reports heartbeat period in 2^x microseconds, with 0 meaning not supported. OCP Recovery v1.1 Sec 9.2 PROT_CAP/Table 9-3.";
            sw = r;
            hw = w;
            we = false;
            reset = 8'h00;
        } HEARTBEAT_PERIOD[23:16];
        field {
            name = "Reserved";
            desc = "Byte 15 is reserved. OCP Recovery v1.1 Sec 9.2 PROT_CAP/Table 9-3.";
            sw = r;
            hw = w;
            we = false;
            reset = 8'h00;
        } RESERVED_31_24[31:24];
    } PROT_CAP_3 @ 0x00C;

    // DEVICE_ID command (cmd 0x23, bytes 0-23).
    reg {
        name = "Device Identification 0";
        desc = "DEVICE_ID bytes 0-3. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
        field {
            name = "Initial descriptor type";
            desc = "Byte 0 selects the DEVICE_ID encoding such as PCI, IANA, UUID, PnP, ACPI, or NVMe-MI. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
            sw = r;
            hw = w;
            we = false;
            reset = 8'h00;
        } DESC_TYPE[7:0];
        field {
            name = "Vendor specific string length";
            desc = "Byte 1 reports the optional vendor string length. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
            sw = r;
            hw = w;
            we = false;
            reset = 8'h00;
        } VENDOR_SPECIFIC_STR_LENGTH[15:8];
        field {
            name = "Descriptor payload bytes 2-3";
            desc = "Bytes 2-3 hold the first descriptor-specific payload bytes for the selected DEVICE_ID type. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
            sw = r;
            hw = w;
            we = false;
            reset = 16'h0000;
        } DATA_3_2[31:16];
    } DEVICE_ID_0 @ 0x010;

    reg {
        name = "Device Identification 1";
        desc = "DEVICE_ID bytes 4-7. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
        field {
            name = "Device ID payload bytes 4-7";
            desc = "Bytes 4-7 carry descriptor-specific DEVICE_ID payload data for the selected descriptor type. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } DATA_7_4[31:0];
    } DEVICE_ID_1 @ 0x014;

    reg {
        name = "Device Identification 2";
        desc = "DEVICE_ID bytes 8-11. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
        field {
            name = "Device ID payload bytes 8-11";
            desc = "Bytes 8-11 carry descriptor-specific DEVICE_ID payload data for the selected descriptor type. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } DATA_11_8[31:0];
    } DEVICE_ID_2 @ 0x018;

    reg {
        name = "Device Identification 3";
        desc = "DEVICE_ID bytes 12-15. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
        field {
            name = "Device ID payload bytes 12-15";
            desc = "Bytes 12-15 carry descriptor-specific DEVICE_ID payload data for the selected descriptor type. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } DATA_15_12[31:0];
    } DEVICE_ID_3 @ 0x01C;

    reg {
        name = "Device Identification 4";
        desc = "DEVICE_ID bytes 16-19. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
        field {
            name = "Device ID payload bytes 16-19";
            desc = "Bytes 16-19 carry descriptor-specific DEVICE_ID payload data for the selected descriptor type. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } DATA_19_16[31:0];
    } DEVICE_ID_4 @ 0x020;

    reg {
        name = "Device Identification 5";
        desc = "DEVICE_ID bytes 20-23. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
        field {
            name = "Device ID payload bytes 20-23";
            desc = "Bytes 20-23 carry descriptor-specific DEVICE_ID payload data for the selected descriptor type. OCP Recovery v1.1 Sec 9.2 DEVICE_ID/Table 9-4.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } DATA_23_20[31:0];
    } DEVICE_ID_5 @ 0x024;

    // DEVICE_STATUS command (cmd 0x24, bytes 0-63 in this USB implementation).
    reg {
        name = "Device Status 0";
        desc = "DEVICE_STATUS bytes 0-3. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5; PROTOCOL_ERROR clear-on-read behavior follows usb_ocp_recovery_regs.sv.";
        field {
            name = "Device status";
            desc = "Byte 0 reports device health and recovery state. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 8'h00;
        } DEV_STATUS[7:0];
        field {
            name = "Protocol error";
            desc = "Byte 1 reports protocol error and clears on successful read, matching OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 and usb_ocp_recovery_regs.sv proto_err_rd_pulse handling.";
            sw = r;
            hw = w;
            we = false;
            onread = rclr;
            reset = 8'h00;
        } PROT_ERROR[15:8];
        field {
            name = "Recovery reason code";
            desc = "Bytes 2-3 report the 16-bit recovery reason code. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 and Table 3.";
            sw = r;
            hw = w;
            we = false;
            reset = 16'h0000;
        } REC_REASON_CODE[31:16];
    } DEVICE_STATUS_0 @ 0x028;

    reg {
        name = "Device Status 1";
        desc = "DEVICE_STATUS bytes 4-7. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
        field {
            name = "Heartbeat";
            desc = "Bytes 4-5 hold the heartbeat counter. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 16'h0000;
        } HEARTBEAT[15:0];
        field {
            name = "Vendor status length";
            desc = "Byte 6 reports the vendor status payload length. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 8'h00;
        } VENDOR_STATUS_LENGTH[23:16];
        field {
            name = "Vendor status byte 0";
            desc = "Byte 7 is the first byte of VENDOR_STATUS. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 8'h00;
        } VENDOR_STATUS_0[31:24];
    } DEVICE_STATUS_1 @ 0x02C;

    reg {
        name = "Device Status 2";
        desc = "DEVICE_STATUS bytes 8-11. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 1-4";
            desc = "Vendor status payload bytes 1-4, corresponding to overall DEVICE_STATUS bytes 8-11. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_4_1[31:0];
    } DEVICE_STATUS_2 @ 0x030;

    reg {
        name = "Device Status 3";
        desc = "DEVICE_STATUS bytes 12-15. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 5-8";
            desc = "Vendor status payload bytes 5-8, corresponding to overall DEVICE_STATUS bytes 12-15. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_8_5[31:0];
    } DEVICE_STATUS_3 @ 0x034;

    reg {
        name = "Device Status 4";
        desc = "DEVICE_STATUS bytes 16-19. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 9-12";
            desc = "Vendor status payload bytes 9-12, corresponding to overall DEVICE_STATUS bytes 16-19. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_12_9[31:0];
    } DEVICE_STATUS_4 @ 0x038;

    reg {
        name = "Device Status 5";
        desc = "DEVICE_STATUS bytes 20-23. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 13-16";
            desc = "Vendor status payload bytes 13-16, corresponding to overall DEVICE_STATUS bytes 20-23. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_16_13[31:0];
    } DEVICE_STATUS_5 @ 0x03C;

    reg {
        name = "Device Status 6";
        desc = "DEVICE_STATUS bytes 24-27. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 17-20";
            desc = "Vendor status payload bytes 17-20, corresponding to overall DEVICE_STATUS bytes 24-27. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_20_17[31:0];
    } DEVICE_STATUS_6 @ 0x040;

    reg {
        name = "Device Status 7";
        desc = "DEVICE_STATUS bytes 28-31. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 21-24";
            desc = "Vendor status payload bytes 21-24, corresponding to overall DEVICE_STATUS bytes 28-31. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_24_21[31:0];
    } DEVICE_STATUS_7 @ 0x044;

    reg {
        name = "Device Status 8";
        desc = "DEVICE_STATUS bytes 32-35. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 25-28";
            desc = "Vendor status payload bytes 25-28, corresponding to overall DEVICE_STATUS bytes 32-35. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_28_25[31:0];
    } DEVICE_STATUS_8 @ 0x048;

    reg {
        name = "Device Status 9";
        desc = "DEVICE_STATUS bytes 36-39. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 29-32";
            desc = "Vendor status payload bytes 29-32, corresponding to overall DEVICE_STATUS bytes 36-39. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_32_29[31:0];
    } DEVICE_STATUS_9 @ 0x04C;

    reg {
        name = "Device Status 10";
        desc = "DEVICE_STATUS bytes 40-43. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 33-36";
            desc = "Vendor status payload bytes 33-36, corresponding to overall DEVICE_STATUS bytes 40-43. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_36_33[31:0];
    } DEVICE_STATUS_10 @ 0x050;

    reg {
        name = "Device Status 11";
        desc = "DEVICE_STATUS bytes 44-47. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 37-40";
            desc = "Vendor status payload bytes 37-40, corresponding to overall DEVICE_STATUS bytes 44-47. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_40_37[31:0];
    } DEVICE_STATUS_11 @ 0x054;

    reg {
        name = "Device Status 12";
        desc = "DEVICE_STATUS bytes 48-51. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 41-44";
            desc = "Vendor status payload bytes 41-44, corresponding to overall DEVICE_STATUS bytes 48-51. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_44_41[31:0];
    } DEVICE_STATUS_12 @ 0x058;

    reg {
        name = "Device Status 13";
        desc = "DEVICE_STATUS bytes 52-55. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 45-48";
            desc = "Vendor status payload bytes 45-48, corresponding to overall DEVICE_STATUS bytes 52-55. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_48_45[31:0];
    } DEVICE_STATUS_13 @ 0x05C;

    reg {
        name = "Device Status 14";
        desc = "DEVICE_STATUS bytes 56-59. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 49-52";
            desc = "Vendor status payload bytes 49-52, corresponding to overall DEVICE_STATUS bytes 56-59. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_52_49[31:0];
    } DEVICE_STATUS_14 @ 0x060;

    reg {
        name = "Device Status 15";
        desc = "DEVICE_STATUS bytes 60-63. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5 vendor payload continuation.";
        field {
            name = "Vendor status bytes 53-56";
            desc = "Vendor status payload bytes 53-56, corresponding to overall DEVICE_STATUS bytes 60-63. OCP Recovery v1.1 Sec 9.2 DEVICE_STATUS/Table 9-5.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } VENDOR_STATUS_56_53[31:0];
    } DEVICE_STATUS_15 @ 0x064;

    // DEVICE_RESET, RECOVERY_CTRL, RECOVERY_STATUS, and HW_STATUS commands.
    reg {
        name = "Reset control";
        desc = "DEVICE_RESET bytes 0-2 plus one pad byte. OCP Recovery v1.1 Sec 9.2 DEVICE_RESET/Table 9-7. Each writable byte carries swmod so the SV recovery FSM sees a one-cycle write strobe directly from the CPUIF path.";
        field {
            name = "Device Reset Control";
            desc = "Byte 0 requests device reset or management reset. swmod gives the FSM a one-cycle write strobe, matching OCP Recovery v1.1 Sec 9.2 DEVICE_RESET/Table 9-7.";
            sw = w;
            hw = r;
            swmod = true;
            reset = 8'h00;
        } RESET_CTRL[7:0];
        field {
            name = "Forced Recovery";
            desc = "Byte 1 controls forced recovery or flashless boot on the next platform reset. OCP Recovery v1.1 Sec 9.2 DEVICE_RESET/Table 9-7.";
            sw = w;
            hw = r;
            swmod = true;
            reset = 8'h00;
        } FORCED_RECOVERY[15:8];
        field {
            name = "Interface Control";
            desc = "Byte 2 controls interface mastering enable. OCP Recovery v1.1 Sec 9.2 DEVICE_RESET/Table 9-7.";
            sw = w;
            hw = r;
            swmod = true;
            reset = 8'h00;
        } IF_CTRL[23:16];
        field {
            name = "Reserved";
            desc = "Byte 3 is padding introduced by the DWORD-aligned RDL view and is not part of the OCP command payload.";
            sw = r;
            hw = na;
            reset = 8'h00;
        } RESERVED_31_24[31:24];
    } DEVICE_RESET @ 0x068;

    reg {
        name = "Recovery configuration/control";
        desc = "RECOVERY_CTRL bytes 0-2 plus one pad byte. OCP Recovery v1.1 Sec 9.2 RECOVERY_CTRL/Table 9-9; CMS / REC_IMG_SEL carry swmod write strobes and ACTIVATE_REC_IMG is hardware-cleared by the recovery FSM consume pulse.";
        field {
            name = "Component Memory Space";
            desc = "Byte 0 selects the component memory space containing the recovery image. swmod gives the FSM a one-cycle write strobe. OCP Recovery v1.1 Sec 9.2 RECOVERY_CTRL/Table 9-9.";
            sw = rw;
            hw = r;
            swmod = true;
            reset = 8'h00;
        } CMS[7:0];
        field {
            name = "Recovery Image Selection";
            desc = "Byte 1 selects memory-window or device-stored recovery image source. swmod gives the FSM a one-cycle write strobe. OCP Recovery v1.1 Sec 9.2 RECOVERY_CTRL/Table 9-9.";
            sw = rw;
            hw = r;
            swmod = true;
            reset = 8'h00;
        } REC_IMG_SEL[15:8];
        field {
            name = "Activate Recovery Image";
            desc = "Byte 2 requests activation of the selected recovery image. The host writes 0x0F to request activation (OCP Recovery v1.1 Sec 9.2 RECOVERY_CTRL/Table 9-9); the recovery FSM consumes the request and hardware-clears the byte via hwclr. swmod gives the FSM a one-cycle write strobe.";
            sw = rw;
            hw = r;
            hwclr;
            swmod = true;
            reset = 8'h00;
        } ACTIVATE_REC_IMG[23:16];
        field {
            name = "Reserved";
            desc = "Byte 3 is padding introduced by the DWORD-aligned RDL view and is not part of the OCP command payload.";
            sw = r;
            hw = na;
            reset = 8'h00;
        } RESERVED_31_24[31:24];
    } RECOVERY_CTRL @ 0x06C;

    reg {
        name = "Recovery status";
        desc = "RECOVERY_STATUS bytes 0-1 plus pad bytes. OCP Recovery v1.1 Sec 9.2 RECOVERY_STATUS/Table 9-10.";
        field {
            name = "Device recovery status";
            desc = "Byte 0 bits 3:0 report recovery status. OCP Recovery v1.1 Sec 9.2 RECOVERY_STATUS/Table 9-10.";
            sw = r;
            hw = w;
            we = false;
            reset = 4'h0;
        } DEV_REC_STATUS[3:0];
        field {
            name = "Recovery image index";
            desc = "Byte 0 bits 7:4 report the recovery image index. OCP Recovery v1.1 Sec 9.2 RECOVERY_STATUS/Table 9-10.";
            sw = r;
            hw = w;
            we = false;
            reset = 4'h0;
        } REC_IMG_INDEX[7:4];
        field {
            name = "Vendor specific status";
            desc = "Byte 1 reports vendor-specific recovery status. OCP Recovery v1.1 Sec 9.2 RECOVERY_STATUS/Table 9-10.";
            sw = r;
            hw = w;
            we = false;
            reset = 8'h00;
        } VENDOR_SPECIFIC_STATUS[15:8];
        field {
            name = "Reserved";
            desc = "Bytes 2-3 are padding introduced by the DWORD-aligned RDL view and are not part of the OCP command payload.";
            sw = r;
            hw = na;
            reset = 16'h0000;
        } RESERVED_31_16[31:16];
    } RECOVERY_STATUS @ 0x070;

    reg {
        name = "Hardware status";
        desc = "HW_STATUS bytes 0-3. OCP Recovery v1.1 Sec 9.2 HW_STATUS/Table 9-11; byte layout follows the corrected usb_ocp_recovery_regs.sv implementation.";
        field {
            name = "Device temperature critical";
            desc = "Byte 0 bit 0 reports temperature-critical status. OCP Recovery v1.1 Sec 9.2 HW_STATUS/Table 9-11.";
            sw = r;
            hw = w;
            we = false;
            reset = 1'b0;
        } TEMP_CRITICAL[0:0];
        field {
            name = "Hardware soft error";
            desc = "Byte 0 bit 1 reports a hardware soft error. OCP Recovery v1.1 Sec 9.2 HW_STATUS/Table 9-11.";
            sw = r;
            hw = w;
            we = false;
            reset = 1'b0;
        } SOFT_ERR[1:1];
        field {
            name = "Hardware fatal error";
            desc = "Byte 0 bit 2 reports a hardware fatal error. OCP Recovery v1.1 Sec 9.2 HW_STATUS/Table 9-11.";
            sw = r;
            hw = w;
            we = false;
            reset = 1'b0;
        } FATAL_ERR[2:2];
        field {
            name = "Reserved";
