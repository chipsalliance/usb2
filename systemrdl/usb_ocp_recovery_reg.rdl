        desc = "INDIRECT_FIFO_STATUS bytes 8-11. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_STATUS command summary.";
        field {
            name = "Read Index";
            desc = "Bytes 8-11 report READ_INDEX in 4-byte units. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_STATUS command summary.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } READ_INDEX[31:0];
    } INDIRECT_FIFO_STATUS_2 @ 0x194;

    reg {
        name = "Indirect FIFO Status 3";
        desc = "INDIRECT_FIFO_STATUS bytes 12-15. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_STATUS command summary.";
        field {
            name = "FIFO size";
            desc = "Bytes 12-15 report FIFO_SIZE in 4-byte units. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_STATUS command summary.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } FIFO_SIZE[31:0];
    } INDIRECT_FIFO_STATUS_3 @ 0x198;

    reg {
        name = "Indirect FIFO Status 4";
        desc = "INDIRECT_FIFO_STATUS bytes 16-19. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_STATUS command summary.";
        field {
            name = "Max transfer size";
            desc = "Bytes 16-19 report MAX_TRANSFER_SIZE in 4-byte units. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_STATUS command summary.";
            sw = r;
            hw = w;
            we = false;
            reset = 32'h00000000;
        } MAX_TRANSFER_SIZE[31:0];
    } INDIRECT_FIFO_STATUS_4 @ 0x19C;

    reg {
        name = "Indirect FIFO Data";
        desc = "INDIRECT_FIFO_DATA placeholder register. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_DATA command summary. This register exists only to publish a SOC_USB_OCP_RECOVERY_INDIRECT_FIFO_DATA address symbol and to anchor the offset in the aperture map; the live byte-mux and pointer-update logic live in usb_ocp_recovery_cms_fifo.sv.";
        field {
            name = "FIFO data placeholder";
            desc = "DWORD placeholder for INDIRECT_FIFO_DATA. The generated adapter must hand this address to the live usb_ocp_recovery_cms_fifo.sv data path rather than infer storage here.";
            sw = rw;
            hw = rw;
            we = true;
            reset = 32'h00000000;
        } DATA[31:0];
    } INDIRECT_FIFO_DATA @ 0x1A0;

    reg {
        name = "Vendor command placeholder";
        desc = "One-byte VENDOR placeholder per Phase 1b D0.I.bis. OCP Recovery v1.1 Sec 9.2 VENDOR command summary. This project intentionally trims the VENDOR aperture to a single byte placeholder and leaves expansion for a later phase.";
        field {
            name = "Vendor placeholder byte";
            desc = "Byte 0 placeholder for the vendor-defined command space. This project currently models only one byte, reset to 0. OCP Recovery v1.1 Sec 9.2 VENDOR command summary.";
            sw = rw;
            hw = na;
            reset = 8'h00;
        } VENDOR_DATA[7:0];
        field {
            name = "Reserved";
            desc = "Bytes 1-3 are padding introduced by the DWORD-aligned RDL view and are not part of the current placeholder payload.";
            sw = r;
            hw = na;
            reset = 24'h000000;
        } RESERVED_31_8[31:8];
    } VENDOR @ 0x1A4;

    reg {
        name = "Window size pad";
        desc = "Padding register used only to force the elaborated usb_ocp_recovery addrmap size to a natural 4 KiB window ending at offset 0xFFC.";
        field {
            name = "Reserved pad";
            desc = "Not part of the OCP Recovery register set. This filler forces a 4 KiB elaborated addrmap for the SoC AHB sub-decoder window.";
            sw = r;
            hw = na;
            reset = 32'h00000000;
        } DATA[31:0];
    } WINDOW_PAD @ 0xFFC;

};
