    // INDIRECT_FIFO_CTRL, INDIRECT_FIFO_STATUS, INDIRECT_FIFO_DATA, and VENDOR commands.
    reg {
        name = "Indirect FIFO Control 0";
        desc = "INDIRECT_FIFO_CTRL bytes 0-3: CMS (byte 0), RESET (byte 1), and IMAGE_SIZE[15:0] (bytes 2-3). OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_CTRL command summary: IMAGE_SIZE occupies command bytes 2-5 and therefore straddles the two DWORD-aligned control registers. Field placement matches usb_ocp_recovery_cms_fifo.sv.";
        field {
            name = "Component Memory Space";
            desc = "Byte 0 selects the FIFO-backed component memory space. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_CTRL command summary.";
            sw = rw;
            hw = r;
            reset = 8'h00;
        } CMS[7:0];
        field {
            name = "Reset";
            desc = "Byte 1 bit 0 requests FIFO reset and the device clears it after use. The USB transport live behavior is implemented in usb_ocp_recovery_cms_fifo.sv. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_CTRL command summary.";
            sw = rw;
            hw = r;
            onwrite = woclr;
            reset = 8'h00;
        } RESET[15:8];
        field {
            name = "Image Size Low";
            desc = "Bytes 2-3: low 16 bits of IMAGE_SIZE (image size to load, in 4-byte units). OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_CTRL command summary places IMAGE_SIZE at command bytes 2-5; this register holds bytes 2-3. Matches usb_ocp_recovery_cms_fifo.sv.";
            sw = rw;
            hw = r;
            reset = 16'h0000;
        } IMAGE_SIZE_LO[31:16];
    } INDIRECT_FIFO_CTRL_0 @ 0x184;

    reg {
        name = "Indirect FIFO Control 1";
        desc = "INDIRECT_FIFO_CTRL bytes 4-7: IMAGE_SIZE[31:16] (bytes 4-5) plus pad bytes 6-7. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_CTRL command summary: IMAGE_SIZE occupies command bytes 2-5 and straddles the two DWORD-aligned control registers. Field placement matches usb_ocp_recovery_cms_fifo.sv.";
        field {
            name = "Image Size High";
            desc = "Bytes 4-5: high 16 bits of IMAGE_SIZE (image size to load, in 4-byte units). OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_CTRL command summary places IMAGE_SIZE at command bytes 2-5; this register holds bytes 4-5. Matches usb_ocp_recovery_cms_fifo.sv.";
            sw = rw;
            hw = r;
            reset = 16'h0000;
        } IMAGE_SIZE_HI[15:0];
        field {
            name = "Reserved";
            desc = "Bytes 6-7 are padding introduced by the DWORD-aligned RDL view and are not part of the OCP command payload.";
            sw = r;
            hw = na;
            reset = 16'h0000;
        } RESERVED_31_16[31:16];
    } INDIRECT_FIFO_CTRL_1 @ 0x188;

    reg {
        name = "Indirect FIFO Status 0";
        desc = "INDIRECT_FIFO_STATUS bytes 0-3. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_STATUS command summary, with USB-specific sticky status bits following usb_ocp_recovery_cms_fifo.sv.";
        field {
            name = "FIFO Empty";
            desc = "Byte 0 bit 0 indicates the FIFO is empty. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_STATUS command summary.";
            sw = r;
            hw = w;
            we = false;
            reset = 1'b1;
        } EMPTY[0:0];
        field {
            name = "FIFO Full";
            desc = "Byte 0 bit 1 indicates the FIFO is full. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_STATUS command summary.";
            sw = r;
            hw = w;
            we = false;
            reset = 1'b0;
        } FULL[1:1];
        field {
            name = "Region Reset sticky status";
            desc = "Byte 0 bit 2 is a USB transport sticky status bit cleared by writing 1 to status byte 0, matching usb_ocp_recovery_cms_fifo.sv.";
            sw = r;
            hw = w;
            we = false;
            reset = 1'b0;
        } REGION_RESET[2:2];
        field {
            name = "Overflow sticky status";
            desc = "Byte 0 bit 3 is a USB transport sticky overflow bit cleared by writing 1 to status byte 0, matching usb_ocp_recovery_cms_fifo.sv.";
            sw = r;
            hw = w;
            we = false;
            reset = 1'b0;
        } OVERFLOW[3:3];
        field {
            name = "Image done sticky status";
            desc = "Byte 0 bit 4 is a USB transport sticky image-done bit cleared by writing 1 to status byte 0, matching usb_ocp_recovery_cms_fifo.sv.";
            sw = r;
            hw = w;
            we = false;
            reset = 1'b0;
        } IMAGE_DONE[4:4];
        field {
            name = "Reserved status bits";
            desc = "Byte 0 bits 7:5 are reserved in this USB transport view.";
            sw = r;
            hw = w;
            we = false;
            reset = 3'h0;
        } RESERVED_7_5[7:5];
        field {
            name = "Region type";
            desc = "Byte 1 reports the selected FIFO region type. The current USB implementation returns 0x00 for code space. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_STATUS command summary and usb_ocp_recovery_cms_fifo.sv.";
            sw = r;
            hw = w;
            we = false;
            reset = 8'h00;
        } REGION_TYPE[15:8];
        field {
            name = "Reserved";
            desc = "Bytes 2-3 are reserved. OCP Recovery v1.1 Sec 9.2 INDIRECT_FIFO_STATUS command summary.";
            sw = r;
            hw = w;
            we = false;
            reset = 16'h0000;
        } RESERVED_31_16[31:16];
    } INDIRECT_FIFO_STATUS_0 @ 0x18C;

