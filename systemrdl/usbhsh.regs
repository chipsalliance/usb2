<?xml version="1.0" encoding="UTF-8"?>
<crr:UniversalDevice xmlns:crr="http://apif.freescale.net/schemas/regs/1.4" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://apif.freescale.net/schemas/regs/1.4 http://apif.freescale.net/schemas/regs/1.4/regs.xsd">
  <!-- Created by svd2crr conversion script, version 1.0 -->
  <creation_info author="$Author: nxp32927 $" date="$Date: Sun Dec 16 23:05:12 2018 $" revision="$Revision: 1.2 $" source="$Source: /ds/vault/18757/server_vault/Projects/production_final/D_SSL_USB_HS_HOSTDEVICE_SYN/spec_source/regs/usbhsh.regs.rca $"/>
  <GeneralPeriphery>
    <GeneralParameters>
      <instance_header>
        <instance_description>LPC-Next0 USB1 High-speed Host Controller</instance_description>
        <instance_long_description/>
        <template_parameters/>
      </instance_header>
      <general_parameter_defs>
        <string_general_parameter name="peripheralType" value="USBHSH" description="Peripheral/Component Type"/>
      </general_parameter_defs>
    </GeneralParameters>
    <dynamic_parameters/>
    <register_defs>
      <address_block name="USB_HSH" byte_order="littleEndian" lau="32">
        <base_address/>
        <bit_order order="lsb0"/>
        <register_def id="CAPLENGTH_CHIPID" name="CAPLENGTH_CHIPID" width="32">
          <brief_description>This register contains the offset value towards the start of the operational register space and the version number of the IP block</brief_description>
          <address offset="0x0"/>
          <reset_value value="0x1010010" mask="0xFFFF00FF"/>
          <bit_field id="CAPLENGTH" name="CAPLENGTH" position="0" width="8" access="RO">
            <brief_description>Capability Length: This is used as an offset.</brief_description>
          </bit_field>
          <reserved_bit_field position="8" width="8" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="CHIPID" name="CHIPID" position="16" width="16" access="RO">
            <brief_description>Chip identification: indicates major and minor revision of the IP: [31:24] = Major revision [23:16] = Minor revision Major revisions used: 0x01: USB2.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="HCSPARAMS" name="HCSPARAMS" width="32">
          <brief_description>Host Controller Structural Parameters</brief_description>
          <address offset="0x4"/>
          <reset_value value="0x10011" mask="0x0001001F"/>
          <bit_field id="N_PORTS" name="N_PORTS" position="0" width="4" access="RO">
            <brief_description>This register specifies the number of physical downstream ports implemented on this host controller.</brief_description>
          </bit_field>
          <bit_field id="PPC" name="PPC" position="4" width="1" access="RO">
            <brief_description>This field indicates whether the host controller implementation includes port power control.</brief_description>
          </bit_field>
          <reserved_bit_field position="5" width="11" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="P_INDICATOR" name="P_INDICATOR" position="16" width="1" access="RO">
            <brief_description>This bit indicates whether the ports support port indicator control.</brief_description>
          </bit_field>
          <reserved_bit_field position="17" width="15" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
        </register_def>
        <register_def id="HCCPARAMS" name="HCCPARAMS" width="32">
          <brief_description>Host Controller Capability Parameters</brief_description>
          <address offset="0x8"/>
          <reset_value value="0x20006" mask="0xFFFFFFFF"/>
          <reserved_bit_field position="0" width="17" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="LPMC" name="LPMC" position="17" width="1" access="RO">
            <brief_description>Link Power Management Capability.</brief_description>
          </bit_field>
          <reserved_bit_field position="18" width="14" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
        </register_def>
        <register_def id="FLADJ_FRINDEX" name="FLADJ_FRINDEX" width="32">
          <brief_description>Frame Length Adjustment</brief_description>
          <address offset="0xC"/>
          <reset_value value="0x20" mask="0x3FFF003F"/>
          <bit_field id="FLADJ" name="FLADJ" position="0" width="6" access="RW">
            <brief_description>Frame Length Timing Value.</brief_description>
          </bit_field>
          <reserved_bit_field position="6" width="10" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="FRINDEX" name="FRINDEX" position="16" width="14" access="RW">
            <brief_description>Frame Index: Bits 29 to16 in this register are used for the frame number field in the SOF packet.</brief_description>
          </bit_field>
          <reserved_bit_field position="30" width="2" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
        </register_def>
        <register_def id="ATL_PTD_BASE_ADDR" name="ATL_PTD_BASE_ADDR" width="32">
          <brief_description>Memory base address where ATL PTD0 is stored</brief_description>
          <address offset="0x10"/>
          <reset_value value="0x0" mask="0xFFFFFFF0"/>
          <reserved_bit_field position="0" width="4" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="ATL_CUR" name="ATL_CUR" position="4" width="5" access="RW">
            <brief_description>This indicates the current PTD that is used by the hardware when it is processing the ATL list.</brief_description>
          </bit_field>
          <bit_field id="ATL_BASE" name="ATL_BASE" position="9" width="23" access="RW">
            <brief_description>Base address to be used by the hardware to find the start of the ATL list.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="ISO_PTD_BASE_ADDR" name="ISO_PTD_BASE_ADDR" width="32">
          <brief_description>Memory base address where ISO PTD0 is stored</brief_description>
          <address offset="0x14"/>
          <reset_value value="0x0" mask="0xFFFFFFE0"/>
          <reserved_bit_field position="0" width="5" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="ISO_FIRST" name="ISO_FIRST" position="5" width="5" access="RW">
            <brief_description>This indicates the first PTD that is used by the hardware when it is processing the ISO list.</brief_description>
          </bit_field>
          <bit_field id="ISO_BASE" name="ISO_BASE" position="10" width="22" access="RW">
            <brief_description>Base address to be used by the hardware to find the start of the ISO list.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="INT_PTD_BASE_ADDR" name="INT_PTD_BASE_ADDR" width="32">
          <brief_description>Memory base address where INT PTD0 is stored</brief_description>
          <address offset="0x18"/>
          <reset_value value="0x0" mask="0xFFFFFFE0"/>
          <reserved_bit_field position="0" width="5" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="INT_FIRST" name="INT_FIRST" position="5" width="5" access="RW">
            <brief_description>This indicates the first PTD that is used by the hardware when it is processing the INT list.</brief_description>
          </bit_field>
          <bit_field id="INT_BASE" name="INT_BASE" position="10" width="22" access="RW">
            <brief_description>Base address to be used by the hardware to find the start of the INT list.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="DATA_PAYLOAD_BASE_ADDR" name="DATA_PAYLOAD_BASE_ADDR" width="32">
          <brief_description>Memory base address that indicates the start of the data payload buffers</brief_description>
          <address offset="0x1C"/>
          <reset_value value="0x0" mask="0xFFFF0000"/>
          <reserved_bit_field position="0" width="16" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="DAT_BASE" name="DAT_BASE" position="16" width="16" access="RW">
            <brief_description>Base address to be used by the hardware to find the start of the data payload section.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="USBCMD" name="USBCMD" width="32">
          <brief_description>USB Command register</brief_description>
          <address offset="0x20"/>
          <reset_value value="0x0" mask="0x1F00078F"/>
          <bit_field id="RS" name="RS" position="0" width="1" access="RW">
            <brief_description>Run/Stop: 1b = Run.</brief_description>
          </bit_field>
          <bit_field id="HCRESET" name="HCRESET" position="1" width="1" access="RW">
            <brief_description>Host Controller Reset: This control bit is used by the software to reset the host controller.</brief_description>
          </bit_field>
          <bit_field id="FLS" name="FLS" position="2" width="2" access="RW">
            <brief_description>Frame List Size: This field specifies the size of the frame list.</brief_description>
          </bit_field>
          <reserved_bit_field position="4" width="3" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="LHCR" name="LHCR" position="7" width="1" access="RW">
            <brief_description>Light Host Controller Reset: This bit allows the driver software to reset the host controller without affecting the state of the ports.</brief_description>
          </bit_field>
          <bit_field id="ATL_EN" name="ATL_EN" position="8" width="1" access="RW">
            <brief_description>ATL List enabled.</brief_description>
          </bit_field>
          <bit_field id="ISO_EN" name="ISO_EN" position="9" width="1" access="RW">
            <brief_description>ISO List enabled.</brief_description>
          </bit_field>
          <bit_field id="INT_EN" name="INT_EN" position="10" width="1" access="RW">
            <brief_description>INT List enabled.</brief_description>
          </bit_field>
          <reserved_bit_field position="11" width="13" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="HIRD" name="HIRD" position="24" width="4" access="RW">
            <brief_description>Host-Initiated Resume Duration.</brief_description>
          </bit_field>
          <bit_field id="LPM_RWU" name="LPM_RWU" position="28" width="1" access="RW">
            <brief_description>bRemoteWake field.</brief_description>
          </bit_field>
          <reserved_bit_field position="29" width="3" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
        </register_def>
        <register_def id="USBSTS" name="USBSTS" width="32">
          <brief_description>USB Interrupt Status register</brief_description>
          <address offset="0x24"/>
          <reset_value value="0x0" mask="0x000F000C"/>
          <reserved_bit_field position="0" width="2" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="PCD" name="PCD" position="2" width="1" access="RW">
            <brief_description>Port Change Detect: The host controller sets this bit to logic 1 when any port has a change bit transition from a 0 to a one or a Force Port Resume bit transition from a 0 to a 1 as a result of a J-K transition detected on a suspended port. or
              - the ID pin value changes or
              - an LPM token has been transmitted to enter LPM L1 suspend state..
              Software must write a one to clear the bit</brief_description>
          </bit_field>
          <bit_field id="FLR" name="FLR" position="3" width="1" access="RW">
            <brief_description>Frame List Rollover: The host controller sets this bit to logic 1 when the frame list index rolls over its maximum value to 0.</brief_description>
          </bit_field>
          <reserved_bit_field position="4" width="12" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="ATL_IRQ" name="ATL_IRQ" position="16" width="1" access="RW">
            <brief_description>ATL IRQ: Indicates that an ATL PTD (with I-bit set) was completed.</brief_description>
          </bit_field>
          <bit_field id="ISO_IRQ" name="ISO_IRQ" position="17" width="1" access="RW">
            <brief_description>ISO IRQ: Indicates that an ISO PTD (with I-bit set) was completed.</brief_description>
          </bit_field>
          <bit_field id="INT_IRQ" name="INT_IRQ" position="18" width="1" access="RW">
            <brief_description>INT IRQ: Indicates that an INT PTD (with I-bit set) was completed.</brief_description>
          </bit_field>
          <bit_field id="SOF_IRQ" name="SOF_IRQ" position="19" width="1" access="RW">
            <brief_description>SOF interrupt: Every time when the host sends a Start of Frame token on the USB bus, this bit is set.</brief_description>
          </bit_field>
          <reserved_bit_field position="20" width="12" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
        </register_def>
        <register_def id="USBINTR" name="USBINTR" width="32">
          <brief_description>USB Interrupt Enable register</brief_description>
          <address offset="0x28"/>
          <reset_value value="0x0" mask="0x000F000C"/>
          <reserved_bit_field position="0" width="2" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="PCDE" name="PCDE" position="2" width="1" access="RW">
            <brief_description>Port Change Detect Interrupt Enable: 1: enable 0: disable.</brief_description>
          </bit_field>
          <bit_field id="FLRE" name="FLRE" position="3" width="1" access="RW">
            <brief_description>Frame List Rollover Interrupt Enable: 1: enable 0: disable.</brief_description>
          </bit_field>
          <reserved_bit_field position="4" width="12" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="ATL_IRQ_E" name="ATL_IRQ_E" position="16" width="1" access="RW">
            <brief_description>ATL IRQ Enable bit: 1: enable 0: disable.</brief_description>
          </bit_field>
          <bit_field id="ISO_IRQ_E" name="ISO_IRQ_E" position="17" width="1" access="RW">
            <brief_description>ISO IRQ Enable bit: 1: enable 0: disable.</brief_description>
          </bit_field>
          <bit_field id="INT_IRQ_E" name="INT_IRQ_E" position="18" width="1" access="RW">
            <brief_description>INT IRQ Enable bit: 1: enable 0: disable.</brief_description>
          </bit_field>
          <bit_field id="SOF_E" name="SOF_E" position="19" width="1" access="RW">
            <brief_description>SOF Interrupt Enable bit: 1: enable 0: disable.</brief_description>
          </bit_field>
          <reserved_bit_field position="20" width="12" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
        </register_def>
        <register_def id="PORTSC1" name="PORTSC1" width="32">
          <brief_description>Port Status and Control register</brief_description>
          <address offset="0x2C"/>
          <reset_value value="0x0" mask="0xFFFFFFFF"/>
          <bit_field id="CCS" name="CCS" position="0" width="1" access="RW">
            <brief_description>Current Connect Status: Logic 1 indicates a device is present on the port.</brief_description>
          </bit_field>
          <bit_field id="CSC" name="CSC" position="1" width="1" access="RW">
            <brief_description>Connect Status Change: Logic 1 means that the value of CCS has changed.</brief_description>
          </bit_field>
          <bit_field id="PED" name="PED" position="2" width="1" access="RW">
            <brief_description>Port Enabled/Disabled.</brief_description>
          </bit_field>
          <bit_field id="PEDC" name="PEDC" position="3" width="1" access="RW">
            <brief_description>Port Enabled/Disabled Change: Logic 1 means that the value of PED has changed.</brief_description>
          </bit_field>
          <bit_field id="OCA" name="OCA" position="4" width="1" access="RW">
            <brief_description>Over-current active: Logic 1 means that this port has an over-current condition.</brief_description>
          </bit_field>
          <bit_field id="OCC" name="OCC" position="5" width="1" access="RW">
            <brief_description>Over-current change: Logic 1 means that the value of OCA has changed.</brief_description>
          </bit_field>
          <bit_field id="FPR" name="FPR" position="6" width="1" access="RW">
            <brief_description>Force Port Resume: Logic 1 means resume (K-state) detected or driven on the port.</brief_description>
          </bit_field>
          <bit_field id="SUSP" name="SUSP" position="7" width="1" access="RW">
            <brief_description>Suspend: Logic 1 means port is in the suspend state.Logic 0 means the port is not suspended.</brief_description>
          </bit_field>
          <bit_field id="PR" name="PR" position="8" width="1" access="RW">
            <brief_description>Port Reset: Logic 1 means the port is in the reset state.</brief_description>
          </bit_field>
          <bit_field id="SUS_L1" name="SUS_L1" position="9" width="1" access="RW">
            <brief_description>Suspend using L1 0b = Suspend using L2 1b = Suspend using L1 When this bit is set to a 1 and a non-zero value is specified in the Device Address field, the host controller will generate an LPM Token to enter the L1 state whenever software writes a one to the Suspend bit, as well as L1 exit timing during any device or host-initiated resume.</brief_description>
          </bit_field>
          <bit_field id="LS" name="LS" position="10" width="2" access="RO">
            <brief_description>Line Status: This field reflects the current logical levels of the DP (bit 11) and DM (bit 10) signal lines.</brief_description>
          </bit_field>
          <bit_field id="PP" name="PP" position="12" width="1" access="RW">
            <brief_description>Port Power: The function of this bit depends on the value of the Port Power Control (PPC) bit in the HCSPARAMS register.</brief_description>
          </bit_field>
          <bit_field name="PFSC" width="1" access="RW" id="PFSC" position="13">
            <brief_description>ReservedPort Force Full Speed Connect. Writing this bit to a 1b will force the port to only connect at full-speed. It disables the chirp sequences that allows the port to identify itself as high-speed</brief_description>
          </bit_field>
          <bit_field id="PIC" name="PIC" position="14" width="2" access="RW">
            <brief_description>Port Indicator Control : Writing to this field has no effect if the P_INDICATOR bit in the HCSPARAMS register is logic 0.</brief_description>
          </bit_field>
          <bit_field id="PTC" name="PTC" position="16" width="4" access="RW">
            <brief_description>Port Test Control: A non-zero value indicates that the port is operating in the test mode as indicated by the value.</brief_description>
          </bit_field>
          <bit_field id="PSPD" name="PSPD" position="20" width="2" access="RW">
            <brief_description>Port Speed: 00b: Low-speed 01b: Full-speed 10b: High-speed 11b: Reserved.</brief_description>
          </bit_field>
          <bit_field id="WOO" name="WOO" position="22" width="1" access="RW">
            <brief_description>Wake on overcurrent enable: Writing this bit to a one enables the port to be sensitive to overcurrent conditions as wake-up events.</brief_description>
          </bit_field>
          <bit_field id="SUS_STAT" name="SUS_STAT" position="23" width="2" access="RW">
            <brief_description>These two bits are used by software to determine whether the most recent L1 suspend request was successful: 00b: Success-state transition was successful (ACK) 01b: Not Yet - Device was unable to enter the L1 state at this time (NYET) 10b: Not supported - Device does not support the L1 state (STALL) 11b: Timeout/Error - Device failed to respond or an error occurred.</brief_description>
          </bit_field>
          <bit_field id="DEV_ADD" name="DEV_ADD" position="25" width="7" access="RW">
            <brief_description>Device Address for LPM tokens.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="ATL_PTD_DONE_MAP" name="ATL_PTD_DONE_MAP" width="32">
          <brief_description>Done map for each ATL PTD</brief_description>
          <address offset="0x30"/>
          <reset_value value="0x0" mask="0xFFFFFFFF"/>
          <bit_field id="ATL_DONE" name="ATL_DONE" position="0" width="32" access="RW">
            <brief_description>The bit corresponding to a certain PTD will be set to logic 1 as soon as that PTD execution is completed.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="ATL_PTD_SKIP_MAP" name="ATL_PTD_SKIP_MAP" width="32">
          <brief_description>Skip map for each ATL PTD</brief_description>
          <address offset="0x34"/>
          <reset_value value="0x0" mask="0xFFFFFFFF"/>
          <bit_field id="ATL_SKIP" name="ATL_SKIP" position="0" width="32" access="RW">
            <brief_description>When a bit in the PTD Skip Map is set to logic 1, the corresponding PTD will be skipped, independent of the V bit setting.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="ISO_PTD_DONE_MAP" name="ISO_PTD_DONE_MAP" width="32">
          <brief_description>Done map for each ISO PTD</brief_description>
          <address offset="0x38"/>
          <reset_value value="0x0" mask="0xFFFFFFFF"/>
          <bit_field id="ISO_DONE" name="ISO_DONE" position="0" width="32" access="RW">
            <brief_description>The bit corresponding to a certain PTD will be set to logic 1 as soon as that PTD execution is completed.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="ISO_PTD_SKIP_MAP" name="ISO_PTD_SKIP_MAP" width="32">
          <brief_description>Skip map for each ISO PTD</brief_description>
          <address offset="0x3C"/>
          <reset_value value="0x0" mask="0xFFFFFFFF"/>
          <bit_field id="ISO_SKIP" name="ISO_SKIP" position="0" width="32" access="RW">
            <brief_description>The bit corresponding to a certain PTD will be set to logic 1 as soon as that PTD execution is completed.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="INT_PTD_DONE_MAP" name="INT_PTD_DONE_MAP" width="32">
          <brief_description>Done map for each INT PTD</brief_description>
          <address offset="0x40"/>
          <reset_value value="0x0" mask="0xFFFFFFFF"/>
          <bit_field id="INT_DONE" name="INT_DONE" position="0" width="32" access="RW">
            <brief_description>The bit corresponding to a certain PTD will be set to logic 1 as soon as that PTD execution is completed.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="INT_PTD_SKIP_MAP" name="INT_PTD_SKIP_MAP" width="32">
          <brief_description>Skip map for each INT PTD</brief_description>
          <address offset="0x44"/>
          <reset_value value="0x0" mask="0xFFFFFFFF"/>
          <bit_field id="INT_SKIP" name="INT_SKIP" position="0" width="32" access="RW">
            <brief_description>When a bit in the PTD Skip Map is set to logic 1, the corresponding PTD will be skipped, independent of the V bit setting.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="LAST_PTD_INUSE" name="LAST_PTD_INUSE" width="32">
          <brief_description>Marks the last PTD in the list for ISO, INT and ATL</brief_description>
          <address offset="0x48"/>
          <reset_value value="0x0" mask="0x001F1F1F"/>
          <bit_field id="ATL_LAST" name="ATL_LAST" position="0" width="5" access="RW">
            <brief_description>If hardware has reached this PTD and the J bit is not set, it will go to PTD0 as the next PTD to be processed.</brief_description>
          </bit_field>
          <reserved_bit_field position="5" width="3" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="ISO_LAST" name="ISO_LAST" position="8" width="5" access="RW">
            <brief_description>This indicates the last PTD in the ISO list.</brief_description>
          </bit_field>
          <reserved_bit_field position="13" width="3" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="INT_LAST" name="INT_LAST" position="16" width="5" access="RW">
            <brief_description>This indicates the last PTD in the INT list.</brief_description>
          </bit_field>
          <reserved_bit_field position="21" width="11" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
        </register_def>
        <register_def id="UTMIPLUS_ULPI_DEBUG" name="UTMIPLUS_ULPI_DEBUG" width="32">
          <brief_description>Register to read/write registers in the attached USB PHY</brief_description>
          <address offset="0x4C"/>
          <reset_value value="0x0" mask="0x83FFFFFF"/>
          <bit_field id="PHY_ADDR" name="PHY_ADDR" position="0" width="8" access="RW">
            <brief_description>UTMI+ mode: Bits 3:0 are used to control VControl signal on Vendor Interface of UTMI+ ULPI mode: Bits 7:0 are used as the address when doing a register access over the ULPI interface.</brief_description>
          </bit_field>
          <bit_field id="PHY_WDATA" name="PHY_WDATA" position="8" width="8" access="RW">
            <brief_description>UTMI+ mode: Reserved.</brief_description>
          </bit_field>
          <bit_field id="PHY_RDATA" name="PHY_RDATA" position="16" width="8" access="RW">
            <brief_description>UTMI+ mode: Bits 7:0 contains the value returned by the VStatus signal on Vendor Interface of UTMI+ ULPI mode: Bits 7:0 are used for the read data when reading a value to a ULPI PHY register.</brief_description>
          </bit_field>
          <bit_field id="PHY_RW" name="PHY_RW" position="24" width="1" access="RW">
            <brief_description>UTMI+ mode: Reserved.</brief_description>
          </bit_field>
          <bit_field id="PHY_ACCESS" name="PHY_ACCESS" position="25" width="1" access="RW">
            <brief_description>Software writes this bit to one to start a read or write operation.</brief_description>
          </bit_field>
          <reserved_bit_field position="26" width="5" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="PHY_MODE" name="PHY_MODE" position="31" width="1" access="RW">
            <brief_description>This bit indicates if the interface between the controller is UTMI+ or ULPI 0b: UTMI+ 1b: ULPI If the hardware supports both modes, this bit is RW by SW.</brief_description>
          </bit_field>
        </register_def>
        <register_def id="PORTMODE" name="PORTMODE" width="32">
          <brief_description>Controls the port if it is attached to the host block or the device block</brief_description>
          <address offset="0x50"/>
          <reset_value value="0x50000" mask="0x000D0101"/>
          <bit_field id="ID0" name="ID0" position="0" width="1" access="RW">
            <brief_description>Port 0 ID pin value.</brief_description>
          </bit_field>
          <reserved_bit_field position="1" width="7" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="ID0_EN" name="ID0_EN" position="8" width="1" access="RW">
            <brief_description>Port 0 ID pin pull-up enable.</brief_description>
          </bit_field>
          <reserved_bit_field position="9" width="7" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="PORT_MODE" name="PORT_MODE" position="16" width="1" access="RW">
            <brief_description>If this bit is set to one, the port will behave as a USB device.
              If this bit is set to zero, the port will be controlled by the USB host block.</brief_description>
          </bit_field>
          <reserved_bit_field position="17" width="1" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
          <bit_field id="SW_CTRL_PDCOM" name="SW_CTRL_PDCOM" position="18" width="1" access="RW">
            <brief_description>This bit indicates if the PHY power-down input is controlled by software or by hardware.</brief_description>
          </bit_field>
          <bit_field id="SW_PDCOM" name="SW_PDCOM" position="19" width="1" access="RW">
            <brief_description>This bit is only used when SW_CTRL_PDCOM is set to 1b.</brief_description>
          </bit_field>
          <reserved_bit_field position="20" width="12" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
        </register_def>
        <register_def id="PACKET_TURNAROUND_TIME" name="PACKET_TURNAROUND_TIME" width="32">
          <brief_description>packet turnaround time register</brief_description>
          <address offset="0x84"/>
          <reset_value value="0x00000564" mask="0x000007FF"/>
          <bit_field id="HOST_TIMEOUT" name="HOST_TIMEOUT" position="0" width="11" access="RW">
            <brief_description>host time out value</brief_description>
          </bit_field>
          <reserved_bit_field position="11" width="21" access="RO">
            <brief_description>Reserved. Read value is undefined, only zero should be written.</brief_description>
          </reserved_bit_field>
        </register_def>
      </address_block>
    </register_defs>
  </GeneralPeriphery>
</crr:UniversalDevice>
